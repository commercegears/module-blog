{
    "name": "commercegears/module-blog",
    "description": "Blog for Magento 2 (Luma and Hyvä): posts, nested categories, tags, authors, scheduling, comments with moderation, SEO, RSS, XML sitemap and WordPress import.",
    "type": "magento2-module",
    "license": "proprietary",
    "authors": [
        {
            "name": "CommerceGears",
            "homepage": "https://commercegears.com/"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-xmlreader": "*",
        "magento/framework": "~103.0.6",
        "commercegears/module-core": "^2.0",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-cms": "*",
        "magento/module-customer": "*",
        "magento/module-email": "*",
        "magento/module-media-storage": "*",
        "magento/module-page-cache": "*",
        "magento/module-sitemap": "*",
        "magento/module-store": "*",
        "magento/module-theme": "*",
        "magento/module-ui": "*",
        "magento/module-url-rewrite": "*",
        "magento/module-widget": "*"
    },
    "suggest": {
        "hyva-themes/magento2-default-theme": "Hyvä storefront templates are included",
        "magento/module-page-builder": "Page Builder for post content (used automatically when installed)",
        "magento/module-re-captcha-ui": "Google reCAPTCHA on the comment form",
        "commercegears/module-seo-suite": "^2.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceGears\\Blog\\": ""
        }
    },
    "replace": {
        "softaware/module-blog": "*"
    }
}
