<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="CommerceGears_Core::core">
                    <resource id="CommerceGears_Blog::blog" title="Blog" sortOrder="45">
                        <resource id="CommerceGears_Blog::posts" title="Posts" sortOrder="10">
                            <resource id="CommerceGears_Blog::posts_save" title="Create and Edit" sortOrder="10"/>
                            <resource id="CommerceGears_Blog::posts_publish" title="Publish" sortOrder="20"/>
                            <resource id="CommerceGears_Blog::posts_delete" title="Delete" sortOrder="30"/>
                        </resource>
                        <resource id="CommerceGears_Blog::categories" title="Categories" sortOrder="20"/>
                        <resource id="CommerceGears_Blog::tags" title="Tags" sortOrder="30"/>
                        <resource id="CommerceGears_Blog::authors" title="Authors" sortOrder="40"/>
                        <resource id="CommerceGears_Blog::comments" title="Comments" sortOrder="50">
                            <resource id="CommerceGears_Blog::comments_moderate" title="Moderate and Reply" sortOrder="10"/>
                            <resource id="CommerceGears_Blog::comments_delete" title="Delete" sortOrder="20"/>
                        </resource>
                        <resource id="CommerceGears_Blog::import" title="WordPress Import" sortOrder="60"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="CommerceGears_Blog::config" title="CommerceGears Blog" sortOrder="85"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
