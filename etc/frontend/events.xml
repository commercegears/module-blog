<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="hyva_config_generate_before">
        <observer name="commercegears_blog_hyva_config" instance="CommerceGears\Blog\Observer\RegisterModuleForHyvaConfig"/>
    </event>
    <event name="page_block_html_topmenu_gethtml_before">
        <observer name="commercegears_blog_top_menu" instance="CommerceGears\Blog\Observer\AddTopMenuLink"/>
    </event>
    <event name="layout_generate_blocks_after">
        <observer name="commercegears_blog_breadcrumb_schema" instance="CommerceGears\Blog\Observer\SkipThemeBreadcrumbSchema"/>
        <observer name="commercegears_blog_footer_link" instance="CommerceGears\Blog\Observer\AddFooterLink"/>
    </event>
</config>
