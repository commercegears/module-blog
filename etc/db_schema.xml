<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="softaware_blog_author" resource="default" engine="innodb" comment="Softaware Blog Author">
        <column xsi:type="int" name="author_id" unsigned="true" nullable="false" identity="true" comment="Author ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="url_key" nullable="false" length="255" comment="URL Key"/>
        <column xsi:type="varchar" name="job_title" nullable="true" length="255" comment="Job Title"/>
        <column xsi:type="text" name="bio" nullable="true" comment="Biography"/>
        <column xsi:type="varchar" name="photo" nullable="true" length="255" comment="Photo"/>
        <column xsi:type="varchar" name="website_url" nullable="true" length="255" comment="Website"/>
        <column xsi:type="varchar" name="linkedin_url" nullable="true" length="255" comment="LinkedIn"/>
        <column xsi:type="varchar" name="x_url" nullable="true" length="255" comment="X (Twitter)"/>
        <column xsi:type="varchar" name="meta_title" nullable="true" length="255" comment="Meta Title"/>
        <column xsi:type="text" name="meta_description" nullable="true" comment="Meta Description"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Active"/>
        <column xsi:type="varchar" name="external_id" nullable="true" length="128" comment="Import Source ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="author_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SOFTAWARE_BLOG_AUTHOR_URL_KEY">
            <column name="url_key"/>
        </constraint>
        <index referenceId="SOFTAWARE_BLOG_AUTHOR_EXTERNAL_ID" indexType="btree">
            <column name="external_id"/>
        </index>
        <index referenceId="SOFTAWARE_BLOG_AUTHOR_NAME" indexType="fulltext">
            <column name="name"/>
        </index>
    </table>

    <table name="softaware_blog_post" resource="default" engine="innodb" comment="Softaware Blog Post">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" identity="true" comment="Post ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Title"/>
        <column xsi:type="varchar" name="url_key" nullable="false" length="255" comment="URL Key"/>
        <column xsi:type="text" name="short_content" nullable="true" comment="Excerpt"/>
        <column xsi:type="mediumtext" name="content" nullable="true" comment="Content"/>
        <column xsi:type="varchar" name="featured_image" nullable="true" length="255" comment="Featured Image"/>
        <column xsi:type="varchar" name="featured_image_alt" nullable="true" length="255" comment="Featured Image Alt Text"/>
        <column xsi:type="int" name="author_id" unsigned="true" nullable="true" comment="Author ID"/>
        <column xsi:type="smallint" name="status" unsigned="true" nullable="false" default="0" comment="0 Draft, 1 Published"/>
        <column xsi:type="datetime" name="publish_at" nullable="true" comment="Publish Date (UTC)"/>
        <column xsi:type="smallint" name="schedule_pending" unsigned="true" nullable="false" default="0" comment="Waiting For Scheduled Publication"/>
        <column xsi:type="smallint" name="is_featured" unsigned="true" nullable="false" default="0" comment="Featured"/>
        <column xsi:type="smallint" name="allow_comments" unsigned="true" nullable="false" default="1" comment="Comments Allowed"/>
        <column xsi:type="varchar" name="meta_title" nullable="true" length="255" comment="Meta Title"/>
        <column xsi:type="text" name="meta_description" nullable="true" comment="Meta Description"/>
        <column xsi:type="text" name="meta_keywords" nullable="true" comment="Meta Keywords"/>
        <column xsi:type="varchar" name="meta_robots" nullable="true" length="32" comment="Meta Robots"/>
        <column xsi:type="varchar" name="canonical_url" nullable="true" length="255" comment="Custom Canonical URL"/>
        <column xsi:type="varchar" name="focus_keyword" nullable="true" length="255" comment="Focus Keyword"/>
        <column xsi:type="smallint" name="seo_score" unsigned="true" nullable="true" comment="SEO Checklist Score"/>
        <column xsi:type="varchar" name="external_id" nullable="true" length="128" comment="Import Source ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_BLOG_POST_AUTHOR_ID_SOFTAWARE_BLOG_AUTHOR_AUTHOR_ID"
                    table="softaware_blog_post" column="author_id" referenceTable="softaware_blog_author"
                    referenceColumn="author_id" onDelete="SET NULL"/>
        <index referenceId="SOFTAWARE_BLOG_POST_URL_KEY" indexType="btree">
            <column name="url_key"/>
        </index>
        <index referenceId="SOFTAWARE_BLOG_POST_STATUS_PUBLISH_AT" indexType="btree">
            <column name="status"/>
            <column name="publish_at"/>
        </index>
        <index referenceId="SOFTAWARE_BLOG_POST_SCHEDULE_PENDING" indexType="btree">
            <column name="schedule_pending"/>
        </index>
        <index referenceId="SOFTAWARE_BLOG_POST_EXTERNAL_ID" indexType="btree">
            <column name="external_id"/>
        </index>
        <index referenceId="SOFTAWARE_BLOG_POST_TITLE" indexType="fulltext">
            <column name="title"/>
        </index>
    </table>

    <table name="softaware_blog_post_store" resource="default" engine="innodb" comment="Softaware Blog Post Store Views">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" comment="Post ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store View ID (0 = all)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_BLOG_POST_STORE_POST_ID_SOFTAWARE_BLOG_POST_POST_ID"
                    table="softaware_blog_post_store" column="post_id" referenceTable="softaware_blog_post"
                    referenceColumn="post_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_BLOG_POST_STORE_STORE_ID_STORE_STORE_ID"
                    table="softaware_blog_post_store" column="store_id" referenceTable="store"
                    referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="SOFTAWARE_BLOG_POST_STORE_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
    </table>

    <table name="softaware_blog_post_content" resource="default" engine="innodb" comment="Softaware Blog Post Store View Content">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" comment="Post ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store View ID"/>
        <column xsi:type="varchar" name="title" nullable="true" length="255" comment="Title"/>
