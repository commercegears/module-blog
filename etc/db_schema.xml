        <index referenceId="SOFTAWARE_BLOG_CATEGORY_URL_KEY" indexType="btree">
            <column name="url_key"/>
        </index>
        <index referenceId="SOFTAWARE_BLOG_CATEGORY_EXTERNAL_ID" indexType="btree">
            <column name="external_id"/>
        </index>
        <index referenceId="SOFTAWARE_BLOG_CATEGORY_NAME" indexType="fulltext">
            <column name="name"/>
        </index>
    </table>

    <table name="softaware_blog_category_content" resource="default" engine="innodb" comment="Softaware Blog Category Store View Content">
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" comment="Category ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store View ID"/>
        <column xsi:type="varchar" name="name" nullable="true" length="255" comment="Name"/>
