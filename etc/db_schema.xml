        <column xsi:type="varchar" name="featured_image_alt" nullable="true" length="255" comment="Featured Image Alt Text"/>
        <column xsi:type="varchar" name="meta_title" nullable="true" length="255" comment="Meta Title"/>
        <column xsi:type="text" name="meta_description" nullable="true" comment="Meta Description"/>
        <column xsi:type="text" name="meta_keywords" nullable="true" comment="Meta Keywords"/>
        <column xsi:type="varchar" name="meta_robots" nullable="true" length="32" comment="Meta Robots"/>
        <column xsi:type="varchar" name="focus_keyword" nullable="true" length="255" comment="Focus Keyword"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_BLOG_POST_CONTENT_POST_ID_SOFTAWARE_BLOG_POST_POST_ID"
                    table="softaware_blog_post_content" column="post_id" referenceTable="softaware_blog_post"
                    referenceColumn="post_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_BLOG_POST_CONTENT_STORE_ID_STORE_STORE_ID"
                    table="softaware_blog_post_content" column="store_id" referenceTable="store"
                    referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="SOFTAWARE_BLOG_POST_CONTENT_STORE_ID_URL_KEY" indexType="btree">
            <column name="store_id"/>
            <column name="url_key"/>
        </index>
    </table>

    <table name="softaware_blog_category" resource="default" engine="innodb" comment="Softaware Blog Category">
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" identity="true" comment="Category ID"/>
        <column xsi:type="int" name="parent_id" unsigned="true" nullable="true" comment="Parent Category ID"/>
        <column xsi:type="varchar" name="path" nullable="false" length="255" default="" comment="ID Path"/>
        <column xsi:type="smallint" name="level" unsigned="true" nullable="false" default="1" comment="Level"/>
        <column xsi:type="int" name="position" unsigned="false" nullable="false" default="0" comment="Position"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="url_key" nullable="false" length="255" comment="URL Key"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="varchar" name="meta_title" nullable="true" length="255" comment="Meta Title"/>
        <column xsi:type="text" name="meta_description" nullable="true" comment="Meta Description"/>
        <column xsi:type="text" name="meta_keywords" nullable="true" comment="Meta Keywords"/>
        <column xsi:type="varchar" name="meta_robots" nullable="true" length="32" comment="Meta Robots"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Active"/>
        <column xsi:type="varchar" name="external_id" nullable="true" length="128" comment="Import Source ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
