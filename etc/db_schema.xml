        </constraint>
        <index referenceId="SOFTAWARE_BLOG_TAG_NAME" indexType="fulltext">
            <column name="name"/>
        </index>
    </table>

    <table name="softaware_blog_tag_content" resource="default" engine="innodb" comment="Softaware Blog Tag Store View Content">
        <column xsi:type="int" name="tag_id" unsigned="true" nullable="false" comment="Tag ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store View ID"/>
        <column xsi:type="varchar" name="name" nullable="true" length="255" comment="Name"/>
        <column xsi:type="varchar" name="url_key" nullable="true" length="255" comment="URL Key"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="varchar" name="meta_title" nullable="true" length="255" comment="Meta Title"/>
