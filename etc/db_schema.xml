                    table="softaware_blog_post_category" column="post_id" referenceTable="softaware_blog_post"
                    referenceColumn="post_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_BLOG_POST_CATEGORY_CATEGORY_ID_SOFTAWARE_BLOG_CATEGORY_CATEGORY_ID"
                    table="softaware_blog_post_category" column="category_id" referenceTable="softaware_blog_category"
