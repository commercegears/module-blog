        <column xsi:type="int" name="tag_id" unsigned="true" nullable="false" comment="Tag ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="post_id"/>
            <column name="tag_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SOFTAWARE_BLOG_POST_TAG_POST_ID_SOFTAWARE_BLOG_POST_POST_ID"
