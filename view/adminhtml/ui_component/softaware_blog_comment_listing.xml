<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_blog_comment_listing.softaware_blog_comment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>softaware_blog_comment_listing_columns</spinner>
        <deps>
            <dep>softaware_blog_comment_listing.softaware_blog_comment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_blog_comment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">comment_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Softaware_Blog::comments</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="softaware_blog_comment_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>comment_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"></filters>
        <massaction name="listing_massaction">
            <action name="approve">
                <settings>
                    <url path="softaware_blog/comment/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>approve</type>
                    <label translate="true">Approve</label>
                </settings>
            </action>
            <action name="reject">
                <settings>
                    <url path="softaware_blog/comment/massStatus">
                        <param name="status">2</param>
                    </url>
                    <type>reject</type>
                    <label translate="true">Reject</label>
                </settings>
            </action>
            <action name="pending">
                <settings>
                    <url path="softaware_blog/comment/massStatus">
                        <param name="status">0</param>
                    </url>
                    <type>pending</type>
                    <label translate="true">Set to Pending</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected comments and their replies? This cannot be undone.</message>
                        <title translate="true">Delete Comments</title>
                    </confirm>
                    <url path="softaware_blog/comment/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="softaware_blog_comment_listing_columns" component="Softaware_Blog/js/grid/listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="emptyTitle" xsi:type="string" translate="true">No comments yet</item>
                <item name="emptyText" xsi:type="string" translate="true">Comments from the post pages appear here for review. Set who may comment and whether comments need approval under Configuration.</item>
            </item>
        </argument>
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">softaware_blog_comment_listing.softaware_blog_comment_listing.softaware_blog_comment_listing_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>comment_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="comment_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="content" class="Softaware\Blog\Ui\Component\Listing\Column\Excerpt" sortOrder="20">
            <settings>
                <filter>text</filter><sortable>false</sortable>
                <label translate="true">Comment</label>
            </settings>
        </column>
        <column name="author_name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="author_email" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">E-mail</label>
            </settings>
        </column>
        <column name="post_title" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Post</label>
            </settings>
        </column>
        <column name="status" component="Softaware_Blog/js/grid/columns/status-badge" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="severity" xsi:type="array">
                        <item name="1" xsi:type="string">grid-severity-notice</item>
                        <item name="0" xsi:type="string">grid-severity-major</item>
                        <item name="2" xsi:type="string">grid-severity-critical</item>
                    </item>
                </item>
            </argument>
            <settings>
                <options class="Softaware\Blog\Model\Source\CommentStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="is_admin_reply" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Store Reply</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType><sorting>desc</sorting>
                <label translate="true">Date</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Softaware\Blog\Ui\Component\Listing\Column\Actions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="editUrlPath" xsi:type="string">softaware_blog/comment/edit</item>
                    <item name="deleteUrlPath" xsi:type="string">softaware_blog/comment/delete</item>
                    <item name="deleteResource" xsi:type="string">Softaware_Blog::comments_delete</item>
                    <item name="entityLabel" xsi:type="string" translate="true">Comment</item>
                    <item name="titleField" xsi:type="string">author_name</item>
                </item>
            </argument>
            <settings>
                <indexField>comment_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
