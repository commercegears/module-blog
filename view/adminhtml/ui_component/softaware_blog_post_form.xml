 */
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_blog_post_form.softaware_blog_post_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Post</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Softaware\Blog\Block\Adminhtml\Edit\BackButton"/>
            <button name="delete" class="Softaware\Blog\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="preview" class="Softaware\Blog\Block\Adminhtml\Edit\PreviewButton"/>
            <button name="save_and_continue" class="Softaware\Blog\Block\Adminhtml\Edit\SaveAndContinueButton"/>
            <button name="save" class="Softaware\Blog\Block\Adminhtml\Edit\SaveButton"/>
        </buttons>
        <namespace>softaware_blog_post_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>softaware_blog_post_form.softaware_blog_post_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_blog_post_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="softaware_blog/post/save"/>
        </settings>
        <dataProvider class="Softaware\Blog\Ui\DataProvider\PostFormDataProvider" name="softaware_blog_post_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>post_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Post</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="post_id" formElement="input" sortOrder="1">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>post_id</dataScope>
            </settings>
        </field>
        <field name="store" formElement="input" sortOrder="2">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>store</dataScope>
            </settings>
        </field>
        <field name="title" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="url_key" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
                <notice translate="true">The last part of the address, for example "choosing-a-yoga-mat". Leave empty to create it from the title.</notice>
                <validation>
                    <rule name="max_text_length" xsi:type="number">200</rule>
                </validation>
                <dataScope>url_key</dataScope>
            </settings>
        </field>
        <field name="status" formElement="select" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <notice translate="true">Published posts with a future publish date are scheduled: they go live automatically.</notice>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\Blog\Model\Source\PostStatus"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="publish_at" formElement="date" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="options" xsi:type="array">
                        <item name="showsTime" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Publish Date</label>
                <notice translate="true">Leave empty to use the moment you publish. Shown on the post and used to sort the blog.</notice>
                <dataScope>publish_at</dataScope>
            </settings>
        </field>
        <field name="is_featured" formElement="checkbox" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Featured</label>
                <notice translate="true">Featured posts are highlighted at the top of the blog home page and can be picked by the Recent Posts widget.</notice>
                <dataScope>is_featured</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="allow_comments" formElement="checkbox" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Allow Comments</label>
                <dataScope>allow_comments</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="author_id" formElement="select" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Author</label>
                <dataScope>author_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\Blog\Model\Source\AuthorOptions"/>
                        <caption translate="true">No author</caption>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="store_ids" formElement="multiselect" sortOrder="80">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <dataType>int</dataType>
                <label translate="true">Store Views</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataScope>store_ids</dataScope>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Magento\Cms\Ui\Component\Listing\Column\Cms\Options"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="category_ids" component="Magento_Ui/js/form/element/ui-select" formElement="select" sortOrder="90">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">true</item>
                    <item name="showCheckbox" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Categories</label>
                <elementTmpl>ui/grid/filters/elements/ui-select</elementTmpl>
                <dataScope>category_ids</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\Blog\Model\Source\CategoryTree"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="tag_names" formElement="input" sortOrder="100">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Tags</label>
                <notice translate="true">Separate tags with commas, for example "running, beginners". New tags are created when you save.</notice>
                <dataScope>tag_names</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="content" sortOrder="20">
        <settings>
            <label translate="true">Content</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="featured_image" formElement="imageUploader" sortOrder="10">
            <settings>
                <label translate="true">Featured Image</label>
                <componentType>imageUploader</componentType>
                <notice translate="true">Shown at the top of the post, in lists and when the post is shared. A wide image works best (for example 1200 x 675 pixels).</notice>
                <dataScope>featured_image</dataScope>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>10485760</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">softaware_blog/post/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <openDialogTitle>Media Gallery</openDialogTitle>
                        <initialMediaGalleryOpenSubpath>softaware_blog</initialMediaGalleryOpenSubpath>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="featured_image_alt" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Featured Image Alt Text</label>
                <notice translate="true">Describes the image for screen readers and search engines.</notice>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataScope>featured_image_alt</dataScope>
            </settings>
        </field>
        <field name="short_content" formElement="textarea" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Excerpt</label>
                <notice translate="true">A sentence or two shown in lists. Leave empty to use the start of the post.</notice>
                <dataScope>short_content</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>3</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
        <field name="content" formElement="wysiwyg" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="height" xsi:type="string">400px</item>
                        <item name="add_variables" xsi:type="boolean">true</item>
                        <item name="add_widgets" xsi:type="boolean">true</item>
                        <item name="add_images" xsi:type="boolean">true</item>
                        <item name="add_directives" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
            <settings>
                <label translate="true">Content</label>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                </additionalClasses>
                <dataScope>content</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <rows>20</rows>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="seo_checklist" sortOrder="30">
        <settings>
            <label translate="true">SEO Checklist</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <container name="checklist" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Softaware_Blog/js/form/seo-checklist</item>
                </item>
            </argument>
        </container>
    </fieldset>

    <fieldset name="seo" sortOrder="40">
        <settings>
            <label translate="true">Search Engine Optimisation</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="focus_keyword" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Focus Keyword</label>
                <notice translate="true">The phrase people search for, for example "yoga mat". Only used by the SEO checklist.</notice>
                <dataScope>focus_keyword</dataScope>
            </settings>
        </field>
        <field name="meta_title" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <notice translate="true">Title in search results; 30 to 60 characters. Leave empty to use the post title.</notice>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataScope>meta_title</dataScope>
            </settings>
        </field>
        <field name="meta_description" formElement="textarea" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
                <notice translate="true">Text in search results; 120 to 160 characters. Leave empty to use the excerpt.</notice>
                <dataScope>meta_description</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>3</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
        <field name="meta_keywords" formElement="textarea" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Keywords</label>
                <dataScope>meta_keywords</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>2</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
        <field name="meta_robots" formElement="select" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Robots</label>
                <dataScope>meta_robots</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Softaware\Blog\Model\Source\EntityRobots"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="canonical_url" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Canonical URL</label>
                <notice translate="true">Only when the post is a copy of a page elsewhere: the full address of the original. The post is then left out of the XML sitemap.</notice>
                <validation>
                    <rule name="validate-url" xsi:type="boolean">true</rule>
                </validation>
                <dataScope>canonical_url</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="related" sortOrder="50">
        <settings>
            <label translate="true">Related Products</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <container name="button_set" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="boolean">false</item>
                    <item name="content" xsi:type="string" translate="true">Products shown below the post. The post also appears in the "From our blog" block of these product pages. Drag the rows to change the order.</item>
                    <item name="template" xsi:type="string">ui/form/components/complex</item>
                </item>
            </argument>
            <button name="button_related" component="Magento_Ui/js/form/components/button">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="title" xsi:type="string" translate="true">Add Related Products</item>
                        <item name="provider" xsi:type="boolean">false</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">softaware_blog_post_form.softaware_blog_post_form.related.modal</item>
                                <item name="actionName" xsi:type="string">toggleModal</item>
                            </item>
                            <item name="1" xsi:type="array">
                                <item name="targetName" xsi:type="string">softaware_blog_post_form.softaware_blog_post_form.related.modal.related_product_listing</item>
                                <item name="actionName" xsi:type="string">render</item>
                            </item>
                        </item>
                    </item>
                </argument>
            </button>
        </container>
        <modal name="modal" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataScope" xsi:type="string"/>
                    <item name="options" xsi:type="array">
                        <item name="title" xsi:type="string" translate="true">Add Related Products</item>
                        <item name="buttons" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="text" xsi:type="string" translate="true">Cancel</item>
                                <item name="actions" xsi:type="array">
                                    <item name="0" xsi:type="string">closeModal</item>
                                </item>
                            </item>
                            <item name="1" xsi:type="array">
                                <item name="text" xsi:type="string" translate="true">Add Selected Products</item>
                                <item name="class" xsi:type="string">action-primary</item>
                                <item name="actions" xsi:type="array">
                                    <item name="0" xsi:type="array">
                                        <item name="targetName" xsi:type="string">index = related_product_listing</item>
                                        <item name="actionName" xsi:type="string">save</item>
                                    </item>
                                    <item name="1" xsi:type="string">closeModal</item>
                                </item>
                            </item>
                        </item>
                    </item>
                </item>
            </argument>
            <insertListing name="related_product_listing">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="autoRender" xsi:type="boolean">false</item>
                        <item name="dataScope" xsi:type="string">related_product_listing</item>
                        <item name="externalProvider" xsi:type="string">softaware_blog_product_picker.softaware_blog_product_picker_data_source</item>
                        <item name="selectionsProvider" xsi:type="string">softaware_blog_product_picker.softaware_blog_product_picker.product_columns.ids</item>
                        <item name="ns" xsi:type="string">softaware_blog_product_picker</item>
                        <item name="realTimeLink" xsi:type="boolean">true</item>
                        <item name="behaviourType" xsi:type="string">simple</item>
                        <item name="externalFilterMode" xsi:type="boolean">true</item>
                        <item name="dataLinks" xsi:type="array">
                            <item name="imports" xsi:type="boolean">false</item>
                            <item name="exports" xsi:type="boolean">true</item>
                        </item>
                    </item>
                </argument>
                <settings>
                    <renderUrl path="mui/index/render"/>
                </settings>
            </insertListing>
        </modal>
        <dynamicRows name="related" sortOrder="30" component="Magento_Ui/js/dynamic-rows/dynamic-rows-grid" template="ui/dynamic-rows/templates/grid">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">admin__field-wide</item>
                    <item name="columnsHeader" xsi:type="boolean">false</item>
                    <item name="columnsHeaderAfterRender" xsi:type="boolean">true</item>
                    <item name="renderDefaultRecord" xsi:type="boolean">false</item>
                    <item name="addButton" xsi:type="boolean">false</item>
                    <item name="recordTemplate" xsi:type="string">record</item>
                    <item name="dataScope" xsi:type="string">links</item>
                    <item name="deleteButtonLabel" xsi:type="string" translate="true">Remove</item>
                    <item name="dataProvider" xsi:type="string">data.related_product_listing</item>
                    <item name="map" xsi:type="array">
                        <item name="id" xsi:type="string">entity_id</item>
                        <item name="name" xsi:type="string">name</item>
                        <item name="sku" xsi:type="string">sku</item>
                        <item name="status" xsi:type="string">status_text</item>
                        <item name="thumbnail" xsi:type="string">thumbnail_src</item>
                    </item>
                    <item name="links" xsi:type="array">
                        <item name="insertData" xsi:type="string">${ $.provider }:${ $.dataProvider }</item>
                    </item>
                    <item name="dndConfig" xsi:type="array">
                        <item name="enabled" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                        <item name="dataScope" xsi:type="string"/>
                    </item>
                </argument>
                <field name="id" formElement="input" sortOrder="10">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="elementTmpl" xsi:type="string">ui/dynamic-rows/cells/text</item>
                            <item name="fit" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">ID</label>
                        <dataScope>id</dataScope>
                    </settings>
                </field>
                <field name="thumbnail" formElement="input" sortOrder="20">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="elementTmpl" xsi:type="string">ui/dynamic-rows/cells/thumbnail</item>
                            <item name="fit" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Thumbnail</label>
                        <dataScope>thumbnail</dataScope>
                    </settings>
                </field>
                <field name="name" formElement="input" sortOrder="30">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="elementTmpl" xsi:type="string">ui/dynamic-rows/cells/text</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Name</label>
                        <dataScope>name</dataScope>
                    </settings>
                </field>
                <field name="sku" formElement="input" sortOrder="40">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="elementTmpl" xsi:type="string">ui/dynamic-rows/cells/text</item>
                            <item name="fit" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">SKU</label>
                        <dataScope>sku</dataScope>
                    </settings>
                </field>
                <field name="status" formElement="input" sortOrder="50">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="elementTmpl" xsi:type="string">ui/dynamic-rows/cells/text</item>
                            <item name="fit" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Status</label>
                        <dataScope>status</dataScope>
                    </settings>
                </field>
                <actionDelete name="actionDelete" sortOrder="60">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="additionalClasses" xsi:type="string">data-grid-actions-cell</item>
                            <item name="fit" xsi:type="boolean">true</item>
                        </item>
                    </argument>
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Actions</label>
                    </settings>
                </actionDelete>
                <field name="position" formElement="input" sortOrder="70">
                    <settings>
