<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_blog_category_listing.softaware_blog_category_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Category</label>
            </button>
        </buttons>
        <spinner>softaware_blog_category_listing_columns</spinner>
        <deps>
            <dep>softaware_blog_category_listing.softaware_blog_category_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_blog_category_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">category_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Softaware_Blog::categories</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="softaware_blog_category_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>category_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"></filters>
        <massaction name="listing_massaction">
            <action name="enable">
                <settings>
                    <url path="softaware_blog/category/massStatus">
                        <param name="status">1</param>
                    </url>
                    <type>enable</type>
                    <label translate="true">Activate</label>
                </settings>
            </action>
            <action name="disable">
                <settings>
                    <url path="softaware_blog/category/massStatus">
                        <param name="status">0</param>
                    </url>
                    <type>disable</type>
                    <label translate="true">Deactivate</label>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected categories? Posts are kept; subcategories move to the top level.</message>
                        <title translate="true">Delete Categories</title>
                    </confirm>
                    <url path="softaware_blog/category/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="softaware_blog_category_listing_columns" component="Softaware_Blog/js/grid/listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="emptyTitle" xsi:type="string" translate="true">No categories yet</item>
                <item name="emptyText" xsi:type="string" translate="true">Categories group your posts and can be nested, for example Guides &gt; Running.</item>
                <item name="emptyActionLabel" xsi:type="string" translate="true">Add Your First Category</item>
                <item name="emptyActionUrl" xsi:type="url" path="softaware_blog/category/new"/>
            </item>
        </argument>
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">softaware_blog_category_listing.softaware_blog_category_listing.softaware_blog_category_listing_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>category_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="category_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="name" class="Softaware\Blog\Ui\Component\Listing\Column\CategoryName" sortOrder="20">
            <settings>
                <filter>text</filter><bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="parent_name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Parent</label>
            </settings>
        </column>
        <column name="url_key" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">URL Key</label>
            </settings>
        </column>
        <column name="position" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Position</label>
            </settings>
        </column>
        <column name="posts_count" sortOrder="60">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Posts</label>
            </settings>
        </column>
        <column name="is_active" component="Softaware_Blog/js/grid/columns/status-badge" sortOrder="70">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="severity" xsi:type="array">
                        <item name="1" xsi:type="string">grid-severity-notice</item>
                        <item name="0" xsi:type="string">grid-severity-minor</item>
                    </item>
                </item>
            </argument>
            <settings>
                <options class="Softaware\Blog\Model\Source\ActiveStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="path" sortOrder="80">
            <settings>
                <sorting>asc</sorting><visible>false</visible>
                <label translate="true">Tree Order</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Softaware\Blog\Ui\Component\Listing\Column\Actions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="editUrlPath" xsi:type="string">softaware_blog/category/edit</item>
                    <item name="deleteUrlPath" xsi:type="string">softaware_blog/category/delete</item>
                    <item name="deleteResource" xsi:type="string">Softaware_Blog::categories</item>
                    <item name="entityLabel" xsi:type="string" translate="true">Category</item>
                    <item name="titleField" xsi:type="string">name</item>
                </item>
            </argument>
            <settings>
                <indexField>category_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
