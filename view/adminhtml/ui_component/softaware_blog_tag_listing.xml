<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_blog_tag_listing.softaware_blog_tag_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Tag</label>
            </button>
        </buttons>
        <spinner>softaware_blog_tag_listing_columns</spinner>
        <deps>
            <dep>softaware_blog_tag_listing.softaware_blog_tag_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_blog_tag_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">tag_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Softaware_Blog::tags</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="softaware_blog_tag_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>tag_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"></filters>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected tags? Posts are kept.</message>
                        <title translate="true">Delete Tags</title>
                    </confirm>
                    <url path="softaware_blog/tag/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="softaware_blog_tag_listing_columns" component="Softaware_Blog/js/grid/listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="emptyTitle" xsi:type="string" translate="true">No tags yet</item>
                <item name="emptyText" xsi:type="string" translate="true">Tags are created when you type them in a post, or add them here first.</item>
                <item name="emptyActionLabel" xsi:type="string" translate="true">Add Your First Tag</item>
                <item name="emptyActionUrl" xsi:type="url" path="softaware_blog/tag/new"/>
            </item>
        </argument>
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">softaware_blog_tag_listing.softaware_blog_tag_listing.softaware_blog_tag_listing_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>tag_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="tag_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter><sorting>asc</sorting>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="url_key" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">URL Key</label>
            </settings>
        </column>
        <column name="posts_count" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Posts</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="50">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Softaware\Blog\Ui\Component\Listing\Column\Actions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="editUrlPath" xsi:type="string">softaware_blog/tag/edit</item>
                    <item name="deleteUrlPath" xsi:type="string">softaware_blog/tag/delete</item>
                    <item name="deleteResource" xsi:type="string">Softaware_Blog::tags</item>
                    <item name="entityLabel" xsi:type="string" translate="true">Tag</item>
                    <item name="titleField" xsi:type="string">name</item>
                </item>
            </argument>
            <settings>
                <indexField>tag_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
