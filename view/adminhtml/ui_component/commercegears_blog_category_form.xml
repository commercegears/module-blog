<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">commercegears_blog_category_form.commercegears_blog_category_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Category</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="CommerceGears\Blog\Block\Adminhtml\Edit\BackButton"/>
            <button name="delete" class="CommerceGears\Blog\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="save_and_continue" class="CommerceGears\Blog\Block\Adminhtml\Edit\SaveAndContinueButton"/>
            <button name="save" class="CommerceGears\Blog\Block\Adminhtml\Edit\SaveButton"/>
        </buttons>
        <namespace>commercegears_blog_category_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>commercegears_blog_category_form.commercegears_blog_category_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="commercegears_blog_category_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="commercegears_blog/category/save"/>
        </settings>
        <dataProvider class="CommerceGears\Blog\Ui\DataProvider\CategoryFormDataProvider" name="commercegears_blog_category_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>category_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Category</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="category_id" formElement="input" sortOrder="1">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>category_id</dataScope>
            </settings>
        </field>
        <field name="store" formElement="input" sortOrder="2">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>store</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataScope>name</dataScope>
            </settings>
        </field>
        <field name="url_key" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
                <notice translate="true">Leave empty to create it from the name.</notice>
                <validation>
                    <rule name="max_text_length" xsi:type="number">200</rule>
                </validation>
                <dataScope>url_key</dataScope>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <notice translate="true">Inactive categories and their subcategories are hidden on the storefront.</notice>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="parent_id" formElement="select" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Parent Category</label>
                <notice translate="true">Place the category inside another one, for example Running inside Guides.</notice>
                <dataScope>parent_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="position" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Position</label>
                <notice translate="true">Order among categories of the same parent; lower numbers first.</notice>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
                <dataScope>position</dataScope>
            </settings>
        </field>
        <field name="description" formElement="wysiwyg" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="height" xsi:type="string">200px</item>
                        <item name="add_variables" xsi:type="boolean">false</item>
                        <item name="add_widgets" xsi:type="boolean">false</item>
                        <item name="add_images" xsi:type="boolean">true</item>
                        <item name="add_directives" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
            <settings>
                <label translate="true">Description</label>
                <notice translate="true">Shown above the posts of the category.</notice>
                <dataScope>description</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <rows>8</rows>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="seo" sortOrder="20">
        <settings>
            <label translate="true">Search Engine Optimisation</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="meta_title" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <notice translate="true">Leave empty to use the name.</notice>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataScope>meta_title</dataScope>
            </settings>
        </field>
        <field name="meta_description" formElement="textarea" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
                <notice translate="true">Leave empty to use the start of the description.</notice>
                <dataScope>meta_description</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>3</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
        <field name="meta_keywords" formElement="textarea" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Keywords</label>
                <dataScope>meta_keywords</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>2</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
        <field name="meta_robots" formElement="select" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Robots</label>
                <dataScope>meta_robots</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="CommerceGears\Blog\Model\Source\EntityRobots"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
