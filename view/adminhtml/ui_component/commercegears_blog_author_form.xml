<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">commercegears_blog_author_form.commercegears_blog_author_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Author</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="CommerceGears\Blog\Block\Adminhtml\Edit\BackButton"/>
            <button name="delete" class="CommerceGears\Blog\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="save_and_continue" class="CommerceGears\Blog\Block\Adminhtml\Edit\SaveAndContinueButton"/>
            <button name="save" class="CommerceGears\Blog\Block\Adminhtml\Edit\SaveButton"/>
        </buttons>
        <namespace>commercegears_blog_author_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>commercegears_blog_author_form.commercegears_blog_author_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="commercegears_blog_author_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="commercegears_blog/author/save"/>
        </settings>
        <dataProvider class="CommerceGears\Blog\Ui\DataProvider\AuthorFormDataProvider" name="commercegears_blog_author_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>author_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Author</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="author_id" formElement="input" sortOrder="1">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>author_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataScope>name</dataScope>
            </settings>
        </field>
        <field name="url_key" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
                <notice translate="true">Address of the author page. Leave empty to create it from the name.</notice>
                <validation>
                    <rule name="max_text_length" xsi:type="number">200</rule>
                </validation>
                <dataScope>url_key</dataScope>
            </settings>
        </field>
        <field name="job_title" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Job Title</label>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataScope>job_title</dataScope>
            </settings>
        </field>
        <field name="is_active" formElement="checkbox" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <notice translate="true">Inactive authors have no profile page and are not named on posts.</notice>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="photo" formElement="imageUploader" sortOrder="50">
            <settings>
                <label translate="true">Photo</label>
                <componentType>imageUploader</componentType>
                <notice translate="true">A square picture works best.</notice>
                <dataScope>photo</dataScope>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>10485760</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">commercegears_blog/author/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <openDialogTitle>Media Gallery</openDialogTitle>
                        <initialMediaGalleryOpenSubpath>commercegears_blog</initialMediaGalleryOpenSubpath>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
        <field name="bio" formElement="textarea" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Biography</label>
                <notice translate="true">Plain text, shown on the author page and below the author's posts.</notice>
                <dataScope>bio</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>5</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
        <field name="website_url" formElement="input" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Website</label>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                    <rule name="validate-url" xsi:type="boolean">true</rule>
                </validation>
                <dataScope>website_url</dataScope>
            </settings>
        </field>
        <field name="linkedin_url" formElement="input" sortOrder="80">
            <settings>
                <dataType>text</dataType>
                <label translate="true">LinkedIn Profile</label>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                    <rule name="validate-url" xsi:type="boolean">true</rule>
                </validation>
                <dataScope>linkedin_url</dataScope>
            </settings>
        </field>
        <field name="x_url" formElement="input" sortOrder="90">
            <settings>
                <dataType>text</dataType>
                <label translate="true">X (Twitter) Profile</label>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                    <rule name="validate-url" xsi:type="boolean">true</rule>
                </validation>
                <dataScope>x_url</dataScope>
            </settings>
        </field>
    </fieldset>
    <fieldset name="seo" sortOrder="20">
        <settings>
            <label translate="true">Search Engine Optimisation</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="meta_title" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <notice translate="true">Leave empty to use "Posts by ...".</notice>
                <validation>
                    <rule name="max_text_length" xsi:type="number">255</rule>
                </validation>
                <dataScope>meta_title</dataScope>
            </settings>
        </field>
        <field name="meta_description" formElement="textarea" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
                <notice translate="true">Leave empty to use the start of the biography.</notice>
                <dataScope>meta_description</dataScope>
            </settings>
            <formElements>
                <textarea>
                    <settings>
                        <rows>3</rows>
                    </settings>
                </textarea>
            </formElements>
        </field>
    </fieldset>
</form>
