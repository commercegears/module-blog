<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Softaware_Blog::css/admin.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template" name="softaware.blog.intro" template="Softaware_Blog::page/intro.phtml" before="-">
                <arguments>
                    <argument name="intro" xsi:type="string" translate="true">Posts of the blog. A post goes live when its status is Published and its publish date has passed; scheduled posts appear automatically.</argument>
                </arguments>
            </block>
            <uiComponent name="softaware_blog_post_listing"/>
        </referenceContainer>
    </body>
</page>
