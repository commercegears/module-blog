<?php
/**
 * @category  Softaware
 * @package   Softaware_Blog
 * @copyright Copyright © Softaware Commerce Ltd (https://softawarecommerce.com/)
 *
 * @var \Softaware\Blog\Block\Adminhtml\Import\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$job = $block->getJob();
if (!$job) {
    return;
}
?>
<p class="softaware-page-intro">
    <?= $escaper->escapeHtml(__(
        '%1, status: %2. Queued %3%4.',
        (string)($job->getData('original_name') ?: $job->getData('file_name')),
        $block->getStatusLabel((string)$job->getData('status')),
        $block->formatUtc((string)$job->getData('created_at')),
        $job->getData('finished_at') ? ', ' . __('finished %1', $block->formatUtc((string)$job->getData('finished_at'))) : ''
    )) ?>
</p>
<ul class="softaware-blog-import-stats">
    <?php foreach ($block->getCounts() as $label => $count): ?>
        <li><strong><?= (int)$count ?></strong><?= $escaper->escapeHtml($label) ?></li>
    <?php endforeach; ?>
</ul>
<div class="admin__fieldset">
    <?php foreach ($block->getOptionLabels() as $label => $value): ?>
        <div class="admin__field">
            <span class="admin__field-label"><span><?= $escaper->escapeHtml($label) ?></span></span>
            <div class="admin__field-control"><?= $escaper->escapeHtml($value) ?></div>
        </div>
    <?php endforeach; ?>
</div>
<h2 class="admin__legend"><?= $escaper->escapeHtml(__('Log')) ?></h2>
<div class="softaware-blog-import-log" tabindex="0"><?= $escaper->escapeHtml((string)$job->getData('log') ?: __('Nothing logged yet. The job starts with the next cron run.')) ?></div>
<p><a class="action-default" href="<?= $escaper->escapeUrl($block->getUrl('softaware_blog/import/index')) ?>"><?= $escaper->escapeHtml(__('Back to WordPress Import')) ?></a></p>
