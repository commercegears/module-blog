?>
<form class="softaware-blog-import-form" method="post" enctype="multipart/form-data"
      action="<?= $escaper->escapeUrl($block->getUploadUrl()) ?>"
      data-mage-init='{"validation": {}}'>
    <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>">
    <fieldset class="admin__fieldset">
        <legend class="admin__legend"><span><?= $escaper->escapeHtml(__('Import a WordPress Export File')) ?></span></legend>
        <div class="admin__field _required">
            <label class="admin__field-label" for="softaware-blog-import-file"><span><?= $escaper->escapeHtml(__('Export File')) ?></span></label>
            <div class="admin__field-control">
                <input type="file" id="softaware-blog-import-file" name="import_file" accept=".xml,text/xml,application/xml"
                       class="admin__control-file required-entry" data-validate='{"required": true}'>
                <div class="admin__field-note">
                    <?= $escaper->escapeHtml(__('In WordPress: Tools > Export > All content. Up to %1 MB here; import larger files on the command line.', $block->getMaxUploadMb())) ?>
                </div>
            </div>
        </div>
        <?php if (!$block->isSingleStoreMode()): ?>
            <div class="admin__field">
                <label class="admin__field-label" for="softaware-blog-import-stores"><span><?= $escaper->escapeHtml(__('Store Views')) ?></span></label>
                <div class="admin__field-control">
                    <select id="softaware-blog-import-stores" name="store_ids[]" multiple="multiple" size="6" class="admin__control-multiselect">
                        <?php foreach ($block->getStoreOptions() as $option): ?>
                            <?php if (is_array($option['value'])): ?>
                                <optgroup label="<?= $escaper->escapeHtmlAttr($option['label']) ?>">
                                    <?php foreach ($option['value'] as $store): ?>
                                        <option value="<?= (int)$store['value'] ?>"><?= $escaper->escapeHtml(trim((string)$store['label'])) ?></option>
                                    <?php endforeach; ?>
                                </optgroup>
                            <?php else: ?>
                                <option value="<?= (int)$option['value'] ?>" <?= (int)$option['value'] === 0 ? 'selected' : '' ?>><?= $escaper->escapeHtml(trim((string)$option['label'])) ?></option>
                            <?php endif; ?>
                        <?php endforeach; ?>
                    </select>
                    <div class="admin__field-note"><?= $escaper->escapeHtml(__('The imported posts are shown in these store views; redirects are created for each of them.')) ?></div>
                </div>
            </div>
        <?php endif; ?>
        <?php foreach ([
            'download_images' => [true, __('Download images'), __('Featured images and images in the posts that are stored on the WordPress site are copied to this store. Other images stay linked.')],
            'redirects' => [true, __('Redirect old addresses'), __('Creates 301 redirects from the WordPress post addresses (for example /2024/05/my-post/) to the new blog posts. Useful when the blog ran on this domain. Addresses used by the store are never redirected.')],
            'comments' => [true, __('Import comments'), __('Approved and pending comments; spam, trash, pingbacks and trackbacks are left out.')],
            'as_drafts' => [false, __('Import posts as drafts'), __('Lets you review every post before it goes live.')],
            'update_existing' => [false, __('Update posts imported before'), __('When the same file is imported again, posts are overwritten with the WordPress content. Otherwise they are skipped and your changes are kept.')],
        ] as $name => [$checked, $label, $note]): ?>
            <div class="admin__field">
                <span class="admin__field-label"><span><?= $escaper->escapeHtml($name === 'download_images' ? __('Options') : '') ?></span></span>
                <div class="admin__field-control">
                    <div class="admin__field admin__field-option">
                        <input type="checkbox" class="admin__control-checkbox" id="softaware-blog-import-<?= $escaper->escapeHtmlAttr($name) ?>"
                               name="<?= $escaper->escapeHtmlAttr($name) ?>" value="1" <?= $checked ? 'checked' : '' ?>
                               aria-describedby="softaware-blog-import-<?= $escaper->escapeHtmlAttr($name) ?>-note">
                        <label class="admin__field-label" for="softaware-blog-import-<?= $escaper->escapeHtmlAttr($name) ?>"><?= $escaper->escapeHtml($label) ?></label>
                    </div>
                    <div class="admin__field-note" id="softaware-blog-import-<?= $escaper->escapeHtmlAttr($name) ?>-note"><?= $escaper->escapeHtml($note) ?></div>
                </div>
            </div>
        <?php endforeach; ?>
        <div class="admin__field">
            <span class="admin__field-label"></span>
            <div class="admin__field-control">
                <button type="submit" class="action-primary"><span><?= $escaper->escapeHtml(__('Upload and Import')) ?></span></button>
                <div class="admin__field-note">
                    <?= $escaper->escapeHtml(__('The import runs in the background with cron, in steps, so large blogs are fine. Running it again with the same file adds nothing twice. Command line: bin/magento softaware:blog:import-wordpress <file>')) ?>
                </div>
            </div>
        </div>
    </fieldset>
</form>
