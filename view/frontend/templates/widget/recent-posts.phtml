 */

/**
 * Widget: recent posts (Luma).
 *
 * @var \CommerceGears\Blog\Block\Widget\RecentPosts $block
 * @var \Magento\Framework\Escaper $escaper
 */
$posts = $block->getPosts();
if (!$posts) {
    return;
}
$block->setData('card_no_image', !$block->showImage());
$block->setData('card_show_excerpt', $block->showExcerpt());
?>
<section class="sw-blog sw-blog-widget sw-blog-widget--recent">
    <?php if ($block->getTitle() !== ''): ?>
        <h2 class="sw-blog-section-title"><?= $escaper->escapeHtml($block->getTitle()) ?></h2>
    <?php endif; ?>
    <div class="sw-blog-grid sw-blog-grid--3">
        <?php foreach ($posts as $post): ?>
            <?= /* @noEscape */ $block->renderCard($post, 'compact', 'h3') ?>
        <?php endforeach; ?>
    </div>
    <p class="sw-blog-widget__more"><a href="<?= $escaper->escapeUrl($block->getBlogUrl()) ?>"><?= $escaper->escapeHtml(__('All posts')) ?></a></p>
</section>
