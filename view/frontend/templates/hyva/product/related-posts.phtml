/**
 * "From our blog" on product pages (Hyvä).
 *
 * @var \CommerceGears\Blog\Block\Product\RelatedPosts $block
 * @var \Magento\Framework\Escaper $escaper
 */
$posts = $block->getPosts();
if (!$posts) {
    return;
}
?>
<section class="my-8" aria-labelledby="sw-blog-product-posts-title">
    <h2 id="sw-blog-product-posts-title" class="text-2xl font-medium mb-6"><?= $escaper->escapeHtml($block->getTitle()) ?></h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <?php foreach ($posts as $post): ?>
            <?= /* @noEscape */ $block->renderCard($post, 'compact', 'h3') ?>
        <?php endforeach; ?>
    </div>
</section>
