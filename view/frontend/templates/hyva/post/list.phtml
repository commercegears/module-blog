 */

/**
 * Blog home, category, tag and author pages (Hyvä).
 *
 * @var \CommerceGears\Blog\Block\PostList $block
 * @var \Magento\Framework\Escaper $escaper
 */
$featured = $block->getFeaturedPosts();
$posts = $block->getPosts();
$intro = $block->getIntroHtml();
$author = $block->getCurrentAuthor();
?>
<div class="mb-12">
    <?php if ($author): ?>
        <?php $photo = $block->getImageUrl((string)$author->getData('photo')); ?>
        <div class="flex flex-col sm:flex-row gap-5 items-start mb-10 text-lg">
            <?php if ($photo !== ''): ?>
                <img src="<?= $escaper->escapeUrl($photo) ?>" alt="" loading="lazy" class="w-20 h-20 rounded-full object-cover shrink-0">
            <?php endif; ?>
            <div>
                <?php if ($author->getData('job_title')): ?>
                    <p class="mb-1 font-semibold text-fg-secondary"><?= $escaper->escapeHtml((string)$author->getData('job_title')) ?></p>
                <?php endif; ?>
                <?php if ($author->getData('bio')): ?>
                    <p><?= nl2br($escaper->escapeHtml((string)$author->getData('bio'))) ?></p>
                <?php endif; ?>
            </div>
        </div>
    <?php elseif ($intro !== ''): ?>
        <div class="mb-10 text-lg leading-relaxed text-fg-secondary"><?= /* @noEscape */ $intro ?></div>
    <?php endif; ?>

    <?php if ($featured): ?>
        <?php $featuredColumns = [1 => '', 2 => 'md:grid-cols-2'][count($featured)] ?? 'md:grid-cols-2 lg:grid-cols-3'; ?>
        <section class="grid gap-8 <?= /* @noEscape */ $featuredColumns ?> mb-12 pb-10 border-b border-gray-200"
                 aria-label="<?= $escaper->escapeHtmlAttr(__('Featured posts')) ?>">
            <?php foreach ($featured as $post): ?>
                <?= /* @noEscape */ $block->renderCard($post, 'featured', 'h2') ?>
            <?php endforeach; ?>
        </section>
    <?php endif; ?>

    <?php if ($posts): ?>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 mb-8">
            <?php foreach ($posts as $post): ?>
                <?= /* @noEscape */ $block->renderCard($post, 'default', $featured ? 'h3' : 'h2') ?>
            <?php endforeach; ?>
        </div>
        <?= /* @noEscape */ $block->getPagerHtml() ?>
    <?php elseif (!$featured): ?>
        <div class="message info"><span><?= $escaper->escapeHtml($block->getEmptyText()) ?></span></div>
    <?php endif; ?>
</div>
