 * @copyright Copyright © CommerceGears (https://commercegears.com/)
 */

/**
 * Widget: recent posts (Hyvä).
 *
 * @var \CommerceGears\Blog\Block\Widget\RecentPosts $block
 * @var \Magento\Framework\Escaper $escaper
 */
$posts = $block->getPosts();
if (!$posts) {
    return;
}
$block->setData('card_no_image', !$block->showImage());
$block->setData('card_show_excerpt', $block->showExcerpt());
?>
<section class="my-10">
    <?php if ($block->getTitle() !== ''): ?>
        <h2 class="text-2xl font-semibold mb-6"><?= $escaper->escapeHtml($block->getTitle()) ?></h2>
    <?php endif; ?>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <?php foreach ($posts as $post): ?>
            <?= /* @noEscape */ $block->renderCard($post, 'compact', 'h3') ?>
        <?php endforeach; ?>
    </div>
    <p class="mt-6"><a href="<?= $escaper->escapeUrl($block->getBlogUrl()) ?>" class="text-primary underline"><?= $escaper->escapeHtml(__('All posts')) ?></a></p>
</section>
