 * @copyright Copyright © CommerceGears (https://commercegears.com/)
 */

/**
 * Products linked to the post (Luma).
 *
 * @var \CommerceGears\Blog\Block\Post\RelatedProducts $block
 * @var \Magento\Framework\Escaper $escaper
 */
$products = $block->getProducts();
if (!$products) {
    return;
}
/** @var \Magento\Framework\Data\Helper\PostHelper $postHelper */
$postHelper = $this->helper(\Magento\Framework\Data\Helper\PostHelper::class);
?>
<section class="sw-blog sw-blog-products" aria-labelledby="sw-blog-products-title">
    <h2 id="sw-blog-products-title" class="sw-blog-section-title"><?= $escaper->escapeHtml($block->getTitle()) ?></h2>
    <ol class="sw-blog-products__list">
        <?php foreach ($products as $product): ?>
            <li class="sw-blog-products__item">
                <a class="sw-blog-products__photo" href="<?= $escaper->escapeUrl($block->getProductUrl($product)) ?>" tabindex="-1">
                    <?= /* @noEscape */ $block->getImage($product, 'related_products_list')->toHtml() ?>
                </a>
                <a class="sw-blog-products__name" href="<?= $escaper->escapeUrl($block->getProductUrl($product)) ?>">
                    <?= $escaper->escapeHtml((string)$product->getName()) ?>
                </a>
                <?= /* @noEscape */ $block->getProductPrice($product) ?>
                <?php if ($product->isSaleable()): ?>
                    <div class="sw-blog-products__actions">
                        <?php if (!$product->isComposite() && $product->getTypeInstance()->isPossibleBuyFromList($product)): ?>
                            <?php $postData = $postHelper->getPostData(
                                $block->getAddToCartUrl($product),
                                ['product' => (int)$product->getId()]
                            ); ?>
                            <button type="button" class="action tocart primary"
                                    data-post="<?= $escaper->escapeHtmlAttr($postData) ?>"
                                    title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>">
                                <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                            </button>
                        <?php else: ?>
                            <a class="action tocart primary" href="<?= $escaper->escapeUrl($block->getProductUrl($product)) ?>"
                               title="<?= $escaper->escapeHtmlAttr(__('Choose options')) ?>">
                                <span><?= $escaper->escapeHtml(__('Choose options')) ?></span>
                            </a>
                        <?php endif; ?>
                    </div>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ol>
</section>
