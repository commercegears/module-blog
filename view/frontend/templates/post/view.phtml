<?php
/**
 * @category  Softaware
 * @package   Softaware_Blog
 * @copyright Copyright © Softaware Commerce Ltd (https://softawarecommerce.com/)
 */

/**
 * Post page (Luma).
 *
 * @var \Softaware\Blog\Block\Post\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$post = $block->getPost();
if (!$post) {
    return;
}
$author = $block->getPostAuthor();
$categories = $block->getPostCategories($post);
$tags = $block->getTags();
$image = $block->getImageUrl($post->getFeaturedImage());
$minutes = $block->getReadingMinutes($post);
$neighbours = $block->getNeighbours();
$share = $block->getShareLinks();
?>
<article class="sw-blog sw-blog-post">
    <?php if ($block->isPreview()): ?>
        <div class="message warning"><div>
            <?= $escaper->escapeHtml($block->isScheduled()
                ? __('Preview: this post is scheduled for %1 and is not visible to visitors yet.', $block->formatPublishDate($post, \IntlDateFormatter::LONG))
                : __('Preview: this post is a draft and is not visible to visitors.')) ?>
        </div></div>
    <?php endif; ?>
    <header class="sw-blog-post__header">
        <?php if ($categories): ?>
            <p class="sw-blog-post__categories">
                <?php foreach ($categories as $category): ?>
                    <a href="<?= $escaper->escapeUrl($block->getCategoryUrl($category)) ?>"><?= $escaper->escapeHtml($category->getName()) ?></a>
                <?php endforeach; ?>
            </p>
        <?php endif; ?>
        <h1 class="page-title sw-blog-post__title"><span class="base"><?= $escaper->escapeHtml($post->getTitle()) ?></span></h1>
        <p class="sw-blog-post__meta">
            <?php if ($author && $block->showAuthor()): ?>
                <a class="sw-blog-post__author" href="<?= $escaper->escapeUrl($block->getAuthorUrl($author)) ?>">
                    <?php if ($author->getData('photo')): ?>
                        <img class="sw-blog-avatar" src="<?= $escaper->escapeUrl($block->getImageUrl((string)$author->getData('photo'))) ?>" alt="" loading="lazy"/>
                    <?php endif; ?>
                    <span><?= $escaper->escapeHtml($author->getName()) ?></span>
                </a>
                <span aria-hidden="true">&middot;</span>
            <?php endif; ?>
            <time datetime="<?= $escaper->escapeHtmlAttr($block->getIsoDate($post->getPublishAt())) ?>"><?= $escaper->escapeHtml($block->formatPublishDate($post, \IntlDateFormatter::LONG)) ?></time>
            <?php if ($minutes > 0): ?>
                <span aria-hidden="true">&middot;</span>
                <span><?= $escaper->escapeHtml(__('%1 min read', $minutes)) ?></span>
            <?php endif; ?>
        </p>
    </header>

    <?php if ($image !== ''): ?>
        <figure class="sw-blog-post__image">
            <img src="<?= $escaper->escapeUrl($image) ?>" alt="<?= $escaper->escapeHtmlAttr((string)($post->getData('featured_image_alt') ?: '')) ?>" fetchpriority="high"/>
        </figure>
    <?php endif; ?>

    <div class="sw-blog-content"><?= /* @noEscape */ $block->getContentHtml() ?></div>

    <?php if ($tags): ?>
        <ul class="sw-blog-tags" aria-label="<?= $escaper->escapeHtmlAttr(__('Tags')) ?>">
            <?php foreach ($tags as $tag): ?>
                <li><a href="<?= $escaper->escapeUrl($block->getTagUrl($tag)) ?>">#<?= $escaper->escapeHtml($tag->getName()) ?></a></li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>

    <?php if ($share): ?>
        <div class="sw-blog-share">
            <span class="sw-blog-share__label"><?= $escaper->escapeHtml(__('Share')) ?></span>
            <?php foreach ($share as $link): ?>
                <a class="sw-blog-share__link" href="<?= $escaper->escapeUrl($link['url']) ?>"
                   <?php if ($link['network'] !== 'email'): ?>target="_blank" rel="noopener noreferrer"<?php endif; ?>>
                    <?= $escaper->escapeHtml($link['label']) ?>
                </a>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <?php if ($author && $block->showAuthor() && ($author->getData('bio') || $author->getData('job_title'))): ?>
        <aside class="sw-blog-author-box" aria-label="<?= $escaper->escapeHtmlAttr(__('About the author')) ?>">
            <?php if ($author->getData('photo')): ?>
                <img class="sw-blog-avatar sw-blog-avatar--large" src="<?= $escaper->escapeUrl($block->getImageUrl((string)$author->getData('photo'))) ?>" alt="" loading="lazy"/>
            <?php endif; ?>
            <div>
                <p class="sw-blog-author-box__name">
                    <a href="<?= $escaper->escapeUrl($block->getAuthorUrl($author)) ?>"><?= $escaper->escapeHtml($author->getName()) ?></a>
                    <?php if ($author->getData('job_title')): ?>
                        <span class="sw-blog-author-box__role"><?= $escaper->escapeHtml((string)$author->getData('job_title')) ?></span>
                    <?php endif; ?>
                </p>
                <?php if ($author->getData('bio')): ?>
                    <p><?= nl2br($escaper->escapeHtml((string)$author->getData('bio'))) ?></p>
                <?php endif; ?>
                <?php $links = $block->getAuthorLinks($author); ?>
                <?php if ($links): ?>
                    <p class="sw-blog-author-box__links">
                        <?php foreach ($links as $label => $url): ?>
                            <a href="<?= $escaper->escapeUrl($url) ?>" target="_blank" rel="noopener me"><?= $escaper->escapeHtml($label) ?></a>
                        <?php endforeach; ?>
                    </p>
                <?php endif; ?>
            </div>
        </aside>
    <?php endif; ?>

    <?php if ($neighbours['prev'] || $neighbours['next']): ?>
        <nav class="sw-blog-neighbours" aria-label="<?= $escaper->escapeHtmlAttr(__('More posts')) ?>">
            <?php if ($neighbours['prev']): ?>
                <a class="sw-blog-neighbours__prev" href="<?= $escaper->escapeUrl($block->getPostUrl($neighbours['prev'])) ?>" rel="prev">
                    <span><?= $escaper->escapeHtml(__('Previous post')) ?></span>
                    <strong><?= $escaper->escapeHtml($neighbours['prev']->getTitle()) ?></strong>
                </a>
            <?php endif; ?>
            <?php if ($neighbours['next']): ?>
                <a class="sw-blog-neighbours__next" href="<?= $escaper->escapeUrl($block->getPostUrl($neighbours['next'])) ?>" rel="next">
                    <span><?= $escaper->escapeHtml(__('Next post')) ?></span>
                    <strong><?= $escaper->escapeHtml($neighbours['next']->getTitle()) ?></strong>
                </a>
            <?php endif; ?>
        </nav>
    <?php endif; ?>
</article>
