<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd" layout="2columns-right">
    <body>
        <referenceBlock name="head.additional">
            <block class="CommerceGears\Blog\Block\Head" name="commercegears.blog.head"/>
        </referenceBlock>
        <referenceContainer name="sidebar.main">
            <block class="CommerceGears\Blog\Block\Sidebar" name="commercegears.blog.sidebar" before="-"
                   template="CommerceGears_Blog::sidebar.phtml"/>
        </referenceContainer>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceBlock name="wishlist_sidebar" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
        <referenceBlock name="multiple-wishlist_sidebar" remove="true"/>
    </body>
</page>
