<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="Softaware\Blog\Block\Post\View" name="softaware.blog.post" template="Softaware_Blog::post/view.phtml"/>
            <block class="Softaware\Blog\Block\Post\RelatedProducts" name="softaware.blog.post.products"
                   template="Softaware_Blog::post/related-products.phtml" after="softaware.blog.post"/>
            <block class="Softaware\Blog\Block\Post\RelatedPosts" name="softaware.blog.post.related"
                   template="Softaware_Blog::post/related-posts.phtml" after="softaware.blog.post.products"/>
            <block class="Softaware\Blog\Block\Post\Comments" name="softaware.blog.post.comments"
                   template="Softaware_Blog::post/comments.phtml" after="softaware.blog.post.related"/>
        </referenceContainer>
    </body>
</page>
